{
  "name": "mcpgsc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute mcpgsc --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute mcpgsc --remote --file=./schema.sql",
    "verify:dashboard": "node scripts/verify-dashboard.mjs && node scripts/verify-console.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
